          <mxGeometry y="28" width="260" height="97" as="geometry" />
        </mxCell>

        <!-- ======================================================== -->
        <!-- COLONNE DROITE : ASSOCIATIONS, NORMALISATION & AUDIT     -->
        <!-- ======================================================== -->

        <!-- Carte 4 : Détail des Associations & Cardinalités -->
        <mxCell id="card-assocs" value="&lt;b&gt;4. DÉTAIL DES 6 ASSOCIATIONS &amp;amp; CARDINALITÉS&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="960" y="110" width="560" height="520" as="geometry" />
        </mxCell>
        <mxCell id="card-assocs-content" value="&lt;table border=&quot;0&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;width:100%; font-size:11px; font-family:Helvetica; color:#1E293B;&quot;&gt;&#10;  &lt;tr style=&quot;background-color:#E2E8F0; font-weight:bold;&quot;&gt;&#10;    &lt;td&gt;Association&lt;/td&gt;&#10;    &lt;td&gt;Entité A&lt;/td&gt;&#10;    &lt;td&gt;Card. A&lt;/td&gt;&#10;    &lt;td&gt;Card. B&lt;/td&gt;&#10;    &lt;td&gt;Entité B&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FEF3C7;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#92400E;&quot;&gt;ENCADRER&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;COACH&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;0,N&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;1,1&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;COURS&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#EDE9FE;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#5B21B6;&quot;&gt;CONCERNER&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;COURS&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;0,N&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;1,1&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;INSCRIPTION&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FCE7F3;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#9D174D;&quot;&gt;EMARGER&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;INSCRIPTION&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;0,1&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;1,1&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;PRESENCE&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#E0F2FE;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#075985;&quot;&gt;EFFECTUER&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;ADHERENT&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;0,N&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;1,1&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;INSCRIPTION&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#CCFBF1;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#115E59;&quot;&gt;SOUSCRIRE&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;ADHERENT&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;0,N&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;1,1&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;ABONNEMENT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FEF3C7;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#92400E;&quot;&gt;REGLER&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;ABONNEMENT&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;0,N&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;1,1&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;PAIEMENT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;&lt;/table&gt;&#10;&lt;br&gt;&#10;&lt;b style=&quot;color:#0F172A;&quot;&gt;Justification fonctionnelle des cardinalités :&lt;/b&gt;&lt;br&gt;&#10;• &lt;b&gt;COACH (0,N) ↔ (1,1) COURS&lt;/b&gt; : Un coach peut animer plusieurs cours ; un cours a un coach titulaire.&lt;br&gt;&#10;• &lt;b&gt;COURS (0,N) ↔ (1,1) INSCRIPTION&lt;/b&gt; : Un cours reçoit des inscriptions ; chaque inscription vise un seul cours.&lt;br&gt;&#10;• &lt;b&gt;INSCRIPTION (0,1) ↔ (1,1) PRESENCE&lt;/b&gt; : Une inscription donne lieu au maximum à un émargement de présence au cours ; tout émargement atteste d&#39;une inscription valide.&lt;br&gt;&#10;• &lt;b&gt;ADHERENT (0,N) ↔ (1,1) INSCRIPTION&lt;/b&gt; : Un membre s&#39;inscrit à plusieurs séances.&lt;br&gt;&#10;• &lt;b&gt;ADHERENT (0,N) ↔ (1,1) ABONNEMENT&lt;/b&gt; : Un membre souscrit des abonnements successifs.&lt;br&gt;&#10;• &lt;b&gt;ABONNEMENT (0,N) ↔ (1,1) PAIEMENT&lt;/b&gt; : Un abonnement fait l&#39;objet de paiements (comptant ou versements multiples) ; un paiement est strictement alloué à un contrat d&#39;adhésion." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-assocs">
          <mxGeometry y="28" width="560" height="492" as="geometry" />
        </mxCell>

        <!-- Carte 5 : Formes Normales (1FN, 2FN, 3FN) -->
        <mxCell id="card-norm" value="&lt;b&gt;5. NORMALISATION CONCEPTUELLE &amp;amp; TRANSITION MLD&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="960" y="655" width="560" height="420" as="geometry" />
        </mxCell>
        <mxCell id="card-norm-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Respect rigoureux des Formes Normales (Codd) :&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Première Forme Normale (1FN) :&lt;/b&gt;&lt;br&gt;Tous les attributs sont scalaires et atomiques. Découplage strict des noms et prénoms, distinction date/heure, séparation montant et date de paiement, et définition d&#39;une clé primaire univoque pour les 7 entités.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Deuxième Forme Normale (2FN) :&lt;/b&gt;&lt;br&gt;Toutes les clés primaires sont élémentaires (mono-attribut : &lt;i&gt;id_coach, id_cours, id_inscription, id_adherent, id_abonnement, id_paiement, id_presence&lt;/i&gt;). Chaque attribut non-clé dépend pleinement et directement de sa clé primaire.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Troisième Forme Normale (3FN) :&lt;/b&gt;&lt;br&gt;Aucun attribut non-clé ne dépend transitivement d&#39;un autre attribut non-clé. L&#39;entité PRESENCE dépend uniquement de l&#39;inscription (qui référence le cours et l&#39;adhérent), évitant toute redondance relationnelle.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Règles de passage MLD :&lt;/b&gt;&lt;br&gt;Pour les relations &lt;b&gt;(0,N) ↔ (1,1)&lt;/b&gt;, la clé primaire du côté &lt;b&gt;(0,N)&lt;/b&gt; migrera comme clé étrangère (&lt;b&gt;FK&lt;/b&gt;) dans la table du côté &lt;b&gt;(1,1)&lt;/b&gt;. Pour la relation &lt;b&gt;(0,1) ↔ (1,1)&lt;/b&gt; entre INSCRIPTION et PRESENCE, &lt;i&gt;id_inscription&lt;/i&gt; migre en clé étrangère UNIQUE dans PRESENCE." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-norm">
          <mxGeometry y="28" width="560" height="392" as="geometry" />
        </mxCell>

        <!-- Carte 6 : Checklist de conformité -->
        <mxCell id="card-audit" value="&lt;b&gt;6. CHECKLIST DE CONFORMITÉ GLOBALE&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="960" y="1100" width="560" height="630" as="geometry" />
        </mxCell>
        <mxCell id="card-audit-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Contrôle des critères d&#39;excellence :&lt;/b&gt;&lt;br&gt;&lt;br&gt;✔ &lt;b&gt;7 entités métier exhaustives :&lt;/b&gt; COACH, COURS, INSCRIPTION, ADHERENT, ABONNEMENT, PAIEMENT, PRESENCE.&lt;br&gt;✔ &lt;b&gt;Gestion complète des paiements :&lt;/b&gt; Entité PAIEMENT liée à ABONNEMENT pour les calculs de chiffre d&#39;affaires mensuel.&lt;br&gt;✔ &lt;b&gt;Gestion complète des présences :&lt;/b&gt; Entité PRESENCE liée à INSCRIPTION pour le classement du Top 3 d&#39;assiduité.&lt;br&gt;✔ &lt;b&gt;Identifiants clairement indiqués :&lt;/b&gt; id_coach, id_cours, id_inscription, id_adherent, id_abonnement, id_paiement, id_presence (soulignés et marqués PK).&lt;br&gt;✔ &lt;b&gt;Aucune relation directe redondante :&lt;/b&gt; Pas de lien parasite direct ADHERENT ↔ COURS ni ADHERENT ↔ PRESENCE.&lt;br&gt;✔ &lt;b&gt;ADMINISTRATEUR exclu :&lt;/b&gt; Rôle système découplé des données d&#39;exploitation.&lt;br&gt;✔ &lt;b&gt;Toutes les cardinalités indiquées :&lt;/b&gt; Visibles sur les liens entre entités et associations.&lt;br&gt;✔ &lt;b&gt;Aucune clé étrangère dans le MCD :&lt;/b&gt; Zéro FK relationnelle dans les entités conceptuelles (respect de la méthode Merise).&lt;br&gt;✔ &lt;b&gt;Organisation graphique soignée :&lt;/b&gt; Alignement vertical clair avec panneaux descriptifs latéraux." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-audit">
          <mxGeometry y="28" width="560" height="602" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
