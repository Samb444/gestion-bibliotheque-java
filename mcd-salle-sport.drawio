        <!-- ======================================================== -->
        <!-- EN-TETE PRINCIPAL DU MCD                                 -->
        <!-- ======================================================== -->
        <mxCell id="mcd-header" value="" style="rounded=1;arcSize=2;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=1;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mcd-title" value="&lt;b style=&quot;font-size: 16px; color: #FFFFFF;&quot;&gt;MODÈLE CONCEPTUEL DE DONNÉES (MCD) — SYSTÈME DE GESTION DE SALLE DE SPORT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #94A3B8;&quot;&gt;Exercice 3 : Conception de Base de Données — Formalisme Merise (Entités Métier, Identifiants PK, Associations, Cardinalités, Présences et Paiements)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="27" width="1020" height="55" as="geometry" />
        </mxCell>
        <mxCell id="mcd-badge-status" value="&lt;b&gt;PHASE 1 (RÉVISÉE) — MCD VALIDÉ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;7 Entités Métier | 6 Associations&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#1E293B;strokeColor=#38BDF8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#38BDF8;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1">
          <mxGeometry x="1270" y="32" width="230" height="45" as="geometry" />
        </mxCell>

        <!-- ======================================================== -->
        <!-- COLONNE GAUCHE : CADRE METHODOLOGIQUE & REGLES METIER    -->
        <!-- ======================================================== -->

        <!-- Carte 1 : Cadre conceptuel Merise -->
        <mxCell id="card-methodo" value="&lt;b&gt;1. DÉMARCHE CONCEPTUELLE MERISE&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="480" height="360" as="geometry" />
        </mxCell>
        <mxCell id="card-methodo-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Principes fondamentaux appliqués :&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Niveau Conceptuel Pur (MCD)&lt;/b&gt; : Modélisation sémantique indépendante de tout SGBD. Aucune syntaxe SQL (&lt;i&gt;CREATE TABLE, VARCHAR, INT&lt;/i&gt;) ni contrainte physique.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Entités Métier (Rectangles)&lt;/b&gt; : 7 entités identifiées, chacune dotée d&#39;attributs atomiques représentatifs du domaine et d&#39;un identifiant unique (&lt;b&gt;PK&lt;/b&gt;) souligné.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Associations Sémantiques (Capsules)&lt;/b&gt; : Les liens métier sont portés par des verbes d&#39;action (&lt;i&gt;ENCADRER, CONCERNER, EFFECTUER, SOUSCRIRE, REGLER, EMARGER&lt;/i&gt;).&lt;br&gt;&lt;br&gt;• &lt;b&gt;Séparation stricte MCD → MLD&lt;/b&gt; : Aucune clé étrangère (FK) n&#39;est présente dans les entités du MCD. Les associations et cardinalités portent seules les liaisons.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Gestion fine des Paiements &amp;amp; Présences&lt;/b&gt; : Intégration de &lt;i&gt;PAIEMENT&lt;/i&gt; (adossé à ABONNEMENT) et de &lt;i&gt;PRESENCE&lt;/i&gt; (adossée à INSCRIPTION) pour assurer le calcul des revenus et le classement des assiduités sans redondance.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Exclusion de l&#39;Administrateur&lt;/b&gt; : Rôle applicatif non persisté en table métier." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-methodo">
          <mxGeometry y="28" width="480" height="332" as="geometry" />
        </mxCell>

        <!-- Carte 2 : Règles de gestion métier -->
        <mxCell id="card-rules" value="&lt;b&gt;2. RÈGLES DE GESTION MÉTIER (RG)&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="495" width="480" height="520" as="geometry" />
        </mxCell>
        <mxCell id="card-rules-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Règles formelles déduites du domaine salle de sport :&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#16A34A;&quot;&gt;[RG1] Coach &amp;amp; Cours :&lt;/b&gt;&lt;br&gt;• Un coach peut encadrer zéro ou plusieurs cours : &lt;b&gt;(0,N)&lt;/b&gt;.&lt;br&gt;• Un cours est encadré obligatoirement par un seul coach : &lt;b&gt;(1,1)&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#4F46E5;&quot;&gt;[RG2] Cours &amp;amp; Inscriptions :&lt;/b&gt;&lt;br&gt;• Un cours peut avoir zéro ou plusieurs inscriptions : &lt;b&gt;(0,N)&lt;/b&gt;.&lt;br&gt;• Une inscription concerne obligatoirement un seul cours : &lt;b&gt;(1,1)&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#2563EB;&quot;&gt;[RG3] Adhérent &amp;amp; Inscriptions :&lt;/b&gt;&lt;br&gt;• Un adhérent peut effectuer zéro ou plusieurs inscriptions : &lt;b&gt;(0,N)&lt;/b&gt;.&lt;br&gt;• Une inscription appartient obligatoirement à un seul adhérent : &lt;b&gt;(1,1)&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#0D9488;&quot;&gt;[RG4] Adhérent &amp;amp; Abonnements :&lt;/b&gt;&lt;br&gt;• Un adhérent peut posséder zéro ou plusieurs abonnements : &lt;b&gt;(0,N)&lt;/b&gt;.&lt;br&gt;• Un abonnement appartient obligatoirement à un seul adhérent : &lt;b&gt;(1,1)&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;[RG5] Abonnement &amp;amp; Paiements :&lt;/b&gt;&lt;br&gt;• Un abonnement peut donner lieu à 0 ou plusieurs paiements (versements/mensualités) : &lt;b&gt;(0,N)&lt;/b&gt;.&lt;br&gt;• Un paiement est obligatoirement émis pour un abonnement spécifique : &lt;b&gt;(1,1)&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#DC2626;&quot;&gt;[RG6] Inscription &amp;amp; Présence :&lt;/b&gt;&lt;br&gt;• Une inscription à une séance peut avoir 0 ou 1 pointage d&#39;émargement de présence : &lt;b&gt;(0,1)&lt;/b&gt;.&lt;br&gt;• Un pointage de présence justifie obligatoirement une inscription préalable : &lt;b&gt;(1,1)&lt;/b&gt;." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-rules">
          <mxGeometry y="28" width="480" height="492" as="geometry" />
        </mxCell>

        <!-- Carte 3 : Synthèse des 7 entités -->
        <mxCell id="card-entities" value="&lt;b&gt;3. SYNTHÈSE DES 7 ENTITÉS DU MODÈLE&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="480" height="690" as="geometry" />
        </mxCell>
        <mxCell id="card-entities-content" value="&lt;table border=&quot;0&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;width:100%; font-size:11px; font-family:Helvetica; color:#1E293B;&quot;&gt;&#10;  &lt;tr style=&quot;background-color:#E2E8F0; font-weight:bold;&quot;&gt;&#10;    &lt;td&gt;Entité&lt;/td&gt;&#10;    &lt;td&gt;Identifiant (PK)&lt;/td&gt;&#10;    &lt;td&gt;Attributs descriptifs&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#F0FDF4;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#16A34A;&quot;&gt;COACH&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_coach&lt;/u&gt;&lt;/td&gt;&#10;    &lt;td&gt;nom, prenom, specialite&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#EEF2FF;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#4F46E5;&quot;&gt;COURS&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_cours&lt;/u&gt;&lt;/td&gt;&#10;    &lt;td&gt;nom, date, heure, capacite_max&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FAF5FF;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#9333EA;&quot;&gt;INSCRIPTION&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_inscription&lt;/u&gt;&lt;/td&gt;&#10;    &lt;td&gt;date_inscription, statut&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#EFF6FF;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#2563EB;&quot;&gt;ADHERENT&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_adherent&lt;/u&gt;&lt;/td&gt;&#10;    &lt;td&gt;nom, prenom, email, telephone&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#F0FDFA;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#0D9488;&quot;&gt;ABONNEMENT&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_abonnement&lt;/u&gt;&lt;/td&gt;&#10;    &lt;td&gt;type, date_debut, date_fin, statut&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FEF3C7;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#D97706;&quot;&gt;PAIEMENT&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_paiement&lt;/u&gt;&lt;/td&gt;&#10;    &lt;td&gt;montant, date_paiement, mode_paiement, statut&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FDF2F8;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#DB2777;&quot;&gt;PRESENCE&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_presence&lt;/u&gt;&lt;/td&gt;&#10;    &lt;td&gt;date_presence, statut_presence&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;&lt;/table&gt;&#10;&lt;br&gt;&#10;&lt;b style=&quot;color:#0F172A;&quot;&gt;Observations méthodologiques :&lt;/b&gt;&lt;br&gt;&#10;• Les 7 entités couvrent exhaustivement toutes les exigences du cahier des charges.&lt;br&gt;&#10;• La séparation nette entre &lt;i&gt;INSCRIPTION&lt;/i&gt; (réservation amont) et &lt;i&gt;PRESENCE&lt;/i&gt; (constat d&#39;assiduité aval) respecte l&#39;atomicité et évite d&#39;altérer les inscriptions sans séance échue.&lt;br&gt;&#10;• La relation &lt;i&gt;ABONNEMENT → PAIEMENT&lt;/i&gt; offre la traçabilité complète des transactions financières nécessaires au calcul des revenus mensuels.&lt;br&gt;&#10;• Zéro clé étrangère dans le MCD : intégrité assurée par la théorie Merise." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-entities">
          <mxGeometry y="28" width="480" height="662" as="geometry" />
        </mxCell>

