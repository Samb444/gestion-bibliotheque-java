        <!-- Entité 4 : ADHERENT -->
        <mxCell id="ent-adherent" value="&lt;b&gt;ADHERENT&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=4;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="590" y="985" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ent-adherent-attrs" value="&lt;b&gt;&lt;u&gt;id_adherent&lt;/u&gt;&lt;/b&gt; (PK)&lt;br&gt;nom&lt;br&gt;prenom&lt;br&gt;email&lt;br&gt;telephone" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingRight=6;spacingTop=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;" vertex="1" parent="ent-adherent">
          <mxGeometry y="28" width="260" height="112" as="geometry" />
        </mxCell>

        <!-- Association 4 : SOUSCRIRE -->
        <mxCell id="rel-souscrire" value="&lt;b&gt;SOUSCRIRE&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#115E59;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="630" y="1170" width="180" height="46" as="geometry" />
        </mxCell>

        <!-- Connecteur ADHERENT - SOUSCRIRE -->
        <mxCell id="link-adh-souscrire" style="endArrow=none;html=1;rounded=0;strokeColor=#2563EB;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent-adherent" target="rel-souscrire">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Cardinalité côté ADHERENT -->
        <mxCell id="card-adh-souscrire" value="0,N" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#2563EB;" vertex="1" parent="1">
          <mxGeometry x="725" y="1135" width="40" height="20" as="geometry" />
        </mxCell>

        <!-- Connecteur SOUSCRIRE - ABONNEMENT -->
        <mxCell id="link-souscrire-abonn" style="endArrow=none;html=1;rounded=0;strokeColor=#0D9488;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rel-souscrire" target="ent-abonnement">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Cardinalité côté ABONNEMENT -->
        <mxCell id="card-souscrire-abonn" value="1,1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#0D9488;" vertex="1" parent="1">
          <mxGeometry x="725" y="1230" width="40" height="20" as="geometry" />
        </mxCell>

        <!-- Entité 5 : ABONNEMENT -->
        <mxCell id="ent-abonnement" value="&lt;b&gt;ABONNEMENT&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=4;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#115E59;" vertex="1" parent="1">
          <mxGeometry x="590" y="1265" width="260" height="155" as="geometry" />
        </mxCell>
        <mxCell id="ent-abonnement-attrs" value="&lt;b&gt;&lt;u&gt;id_abonnement&lt;/u&gt;&lt;/b&gt; (PK)&lt;br&gt;type&lt;br&gt;date_debut&lt;br&gt;date_fin&lt;br&gt;statut" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingRight=6;spacingTop=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;" vertex="1" parent="ent-abonnement">
          <mxGeometry y="28" width="260" height="127" as="geometry" />
        </mxCell>

        <!-- ======================================================== -->
        <!-- COLONNE DROITE : ASSOCIATIONS, NORMALISATION & AUDIT     -->
        <!-- ======================================================== -->

        <!-- Carte 4 : Détail des Associations & Cardinalités -->
        <mxCell id="card-assocs" value="&lt;b&gt;4. DÉTAIL DES ASSOCIATIONS &amp;amp; CARDINALITÉS&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="920" y="110" width="480" height="440" as="geometry" />
        </mxCell>
        <mxCell id="card-assocs-content" value="&lt;table border=&quot;0&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;width:100%; font-size:11px; font-family:Helvetica; color:#1E293B;&quot;&gt;&#10;  &lt;tr style=&quot;background-color:#E2E8F0; font-weight:bold;&quot;&gt;&#10;    &lt;td&gt;Association&lt;/td&gt;&#10;    &lt;td&gt;Entité A&lt;/td&gt;&#10;    &lt;td&gt;Card. A&lt;/td&gt;&#10;    &lt;td&gt;Card. B&lt;/td&gt;&#10;    &lt;td&gt;Entité B&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FEF3C7;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#92400E;&quot;&gt;ENCADRER&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;COACH&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;0,N&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;1,1&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;COURS&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#EDE9FE;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#5B21B6;&quot;&gt;CONCERNER&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;COURS&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;0,N&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;1,1&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;INSCRIPTION&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#E0F2FE;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#075985;&quot;&gt;EFFECTUER&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;ADHERENT&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;0,N&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;1,1&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;INSCRIPTION&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#CCFBF1;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#115E59;&quot;&gt;SOUSCRIRE&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;ADHERENT&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;0,N&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;b&gt;1,1&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;ABONNEMENT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;&lt;/table&gt;&#10;&lt;br&gt;&#10;&lt;b style=&quot;color:#0F172A;&quot;&gt;Justification fonctionnelle des cardinalités :&lt;/b&gt;&lt;br&gt;&#10;• &lt;b&gt;COACH (0,N)&lt;/b&gt; : Un nouveau coach ou remplaçant peut n&#39;avoir aucun cours assigné actuellement.&lt;br&gt;&#10;• &lt;b&gt;COURS (1,1)&lt;/b&gt; : Tout cours au planning doit obligatoirement avoir son coach référent.&lt;br&gt;&#10;• &lt;b&gt;COURS (0,N)&lt;/b&gt; : Un cours nouvellement publié commence à 0 inscription.&lt;br&gt;&#10;• &lt;b&gt;INSCRIPTION (1,1)&lt;/b&gt; : Une inscription vise un cours unique et appartient à un seul adhérent.&lt;br&gt;&#10;• &lt;b&gt;ADHERENT (0,N)&lt;/b&gt; : Un adhérent nouvellement créé n&#39;a pas encore d&#39;inscription ni d&#39;abonnement.&lt;br&gt;&#10;• &lt;b&gt;ABONNEMENT (1,1)&lt;/b&gt; : Un abonnement émis est nominatif et rattaché à un unique adhérent." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-assocs">
          <mxGeometry y="28" width="480" height="412" as="geometry" />
        </mxCell>

        <!-- Carte 5 : Formes Normales (1FN, 2FN, 3FN) -->
        <mxCell id="card-norm" value="&lt;b&gt;5. NORMALISATION CONCEPTUELLE&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="920" y="575" width="480" height="365" as="geometry" />
        </mxCell>
        <mxCell id="card-norm-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Respect rigoureux des Formes Normales :&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Première Forme Normale (1FN) :&lt;/b&gt;&lt;br&gt;Tous les attributs sont atomiques. Les noms et prénoms sont distincts, la date et l&#39;heure de cours sont individualisées, et chaque entité possède une clé primaire identifiante.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Deuxième Forme Normale (2FN) :&lt;/b&gt;&lt;br&gt;Toutes les clés primaires sont élémentaires (mono-attribut : &lt;i&gt;id_adherent, id_coach, id_cours, id_inscription, id_abonnement&lt;/i&gt;). Chaque attribut non-clé dépend pleinement et directement de sa clé primaire.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Troisième Forme Normale (3FN) :&lt;/b&gt;&lt;br&gt;Aucun attribut non-clé ne dépend d&#39;un autre attribut non-clé. Il n&#39;y a pas de dépendance transitive cachée au sein des entités.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Préparation à la dérivation MLD (Phase 2) :&lt;/b&gt;&lt;br&gt;Toutes les associations sont de type &lt;b&gt;(0,N) ↔ (1,1)&lt;/b&gt;. En MLD relationnel, cela se traduira directement par la migration de la clé primaire du côté (0,N) comme clé étrangère (FK) dans la table du côté (1,1)." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-norm">
          <mxGeometry y="28" width="480" height="337" as="geometry" />
        </mxCell>

        <!-- Carte 6 : Checklist de conformité Phase 1 -->
        <mxCell id="card-audit" value="&lt;b&gt;6. CHECKLIST DE CONFORMITÉ — PHASE 1&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="920" y="965" width="480" height="465" as="geometry" />
        </mxCell>
        <mxCell id="card-audit-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Contrôle des 12 critères obligatoires :&lt;/b&gt;&lt;br&gt;&lt;br&gt;✔ &lt;b&gt;Exactement 5 entités métier :&lt;/b&gt; ADHERENT, COACH, COURS, INSCRIPTION, ABONNEMENT.&lt;br&gt;✔ &lt;b&gt;Identifiants clairement indiqués :&lt;/b&gt; id_adherent, id_coach, id_cours, id_inscription, id_abonnement (marqués PK et soulignés).&lt;br&gt;✔ &lt;b&gt;ADHERENT — INSCRIPTION :&lt;/b&gt; Association EFFECTUER (0,N) — (1,1) conforme.&lt;br&gt;✔ &lt;b&gt;COURS — INSCRIPTION :&lt;/b&gt; Association CONCERNER (0,N) — (1,1) conforme.&lt;br&gt;✔ &lt;b&gt;COACH — COURS :&lt;/b&gt; Association ENCADRER (0,N) — (1,1) conforme.&lt;br&gt;✔ &lt;b&gt;ADHERENT — ABONNEMENT :&lt;/b&gt; Association SOUSCRIRE (0,N) — (1,1) conforme.&lt;br&gt;✔ &lt;b&gt;Aucune relation directe ADHERENT ↔ COURS :&lt;/b&gt; Respect du chemin obligatoire via INSCRIPTION.&lt;br&gt;✔ &lt;b&gt;ADMINISTRATEUR exclu du MCD :&lt;/b&gt; Acteur applicatif non persisté en table métier.&lt;br&gt;✔ &lt;b&gt;Toutes les cardinalités visibles :&lt;/b&gt; Placées sur chaque patte de connexion.&lt;br&gt;✔ &lt;b&gt;Aucune notion SQL/MLD :&lt;/b&gt; Pas de VARCHAR, INT, CREATE TABLE, ni clés étrangères relationnelles (absence totale de FK dans les entités).&lt;br&gt;✔ &lt;b&gt;Diagramme lisible et structuré :&lt;/b&gt; Organisation verticale recommandée respectée avec panneaux explicatifs.&lt;br&gt;✔ &lt;b&gt;Fichier dédié :&lt;/b&gt; mcd-salle-sport.drawio créé sans altérer exercice-2-uml-salle-sport.drawio." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-audit">
          <mxGeometry y="28" width="480" height="437" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
