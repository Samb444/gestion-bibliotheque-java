        <!-- Entité 6 (Nouvelle) : PAIEMENT -->
        <mxCell id="ent-paiement" value="&lt;b&gt;PAIEMENT&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=4;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#78350F;" vertex="1" parent="1">
