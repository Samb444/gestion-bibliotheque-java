        <mxCell id="msg-refus" value="inscription refusée" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;strokeWidth=1.5;strokeColor=#DC2626;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#B91C1C;" edge="1" parent="1">
