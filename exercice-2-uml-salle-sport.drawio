        <mxCell id="seq-legend" value="&lt;b&gt;Conventions UML :&lt;/b&gt; &amp;mdash;&amp;rsaquo; Appel synchrone (ligne pleine, flèche pleine) &amp;nbsp;|&amp;nbsp; - - -&amp;rsaquo; Message de retour / réponse (ligne tiretée, flèche ouverte) &amp;nbsp;|&amp;nbsp; &lt;b&gt;alt&lt;/b&gt; Fragment combiné alternatif avec conditions de garde" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
