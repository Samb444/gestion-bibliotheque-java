        <mxCell id="note-cours-complet" value="&lt;b&gt;Cours complet&lt;/b&gt;&lt;br&gt;(capacité maximale atteinte)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontFamily=Helvetica;fontSize=11;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;size=12;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="440" y="355" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="rel-note-complet" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#EF4444;strokeWidth=1;" edge="1" parent="1" source="note-cours-complet">
          <mxGeometry relative="1" as="geometry">
