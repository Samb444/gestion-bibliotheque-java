  <diagram id="diag-sequence-gym" name="Diagramme de séquence">
    <mxGraphModel dx="1280" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="860" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ========================================== -->
        <!-- EN-TETE DU DIAGRAMME                       -->
        <!-- ========================================== -->
        <mxCell id="seq-diag-title" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;DIAGRAMME DE SÉQUENCE UML — INSCRIPTION À UN COURS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #64748B;&quot;&gt;Scénario : Demande d&#39;inscription, vérification de capacité disponible et traitement conditionnel (refus si complet / enregistrement si disponible)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- PARTICIPANTS ET LIGNES DE VIE              -->
        <!-- ========================================== -->
        <!-- Participant 1 : Adhérent -->
        <mxCell id="seq-actor-adherent" value="Adhérent" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};size=40;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="100" y="110" width="120" height="540" as="geometry" />
        </mxCell>

        <!-- Participant 2 : Système -->
        <mxCell id="seq-systeme" value="Système" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};size=40;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="120" height="540" as="geometry" />
        </mxCell>

        <!-- Participant 3 : Cours -->
        <mxCell id="seq-cours" value="Cours" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};size=40;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#312E81;" vertex="1" parent="1">
          <mxGeometry x="600" y="110" width="120" height="540" as="geometry" />
        </mxCell>

        <!-- Participant 4 : Inscription -->
        <mxCell id="seq-inscription" value="Inscription" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};size=40;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#581C87;" vertex="1" parent="1">
          <mxGeometry x="860" y="110" width="120" height="540" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- BARRES D'ACTIVATION (EXECUTION OCCURRENCES) -->
        <!-- ========================================== -->
        <!-- Activation Adhérent -->
        <mxCell id="act-adherent" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="153" y="190" width="14" height="435" as="geometry" />
        </mxCell>

        <!-- Activation Système -->
        <mxCell id="act-systeme" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#E2E8F0;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="393" y="190" width="14" height="435" as="geometry" />
        </mxCell>

        <!-- Activation Cours -->
        <mxCell id="act-cours" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="653" y="230" width="14" height="50" as="geometry" />
        </mxCell>

        <!-- Activation Inscription -->
        <mxCell id="act-inscription" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="913" y="520" width="14" height="50" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- SCÉNARIO PRINCIPAL : MESSAGES INITIAUX    -->
        <!-- ========================================== -->
        <!-- Étape 1 : Demande d'inscription -->
        <mxCell id="msg-inscrire" value="s&#39;inscrireÀUnCours(cours)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#2563EB;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#1E3A8A;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="167" y="195" as="sourcePoint" />
            <mxPoint x="393" y="195" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Étape 2 : Vérification de la capacité -->
        <mxCell id="msg-verifier" value="vérifierCapacité()" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#4F46E5;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#312E81;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="407" y="235" as="sourcePoint" />
            <mxPoint x="653" y="235" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Étape 3 : Retour de la vérification de capacité -->
        <mxCell id="msg-retour-capacite" value="capacitéDisponible" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;strokeWidth=1.5;strokeColor=#4F46E5;fontFamily=Helvetica;fontSize=12;fontColor=#312E81;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="653" y="275" as="sourcePoint" />
            <mxPoint x="407" y="275" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ========================================== -->
        <!-- FRAGMENT COMBINÉ ALT (ALTERNATIVE)         -->
        <!-- ========================================== -->
        <mxCell id="frame-alt" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=60;height=28;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="90" y="315" width="890" height="320" as="geometry" />
        </mxCell>

        <!-- Ligne de séparation des deux branches de l'alternative -->
        <mxCell id="divider-alt" value="" style="line;strokeWidth=1.5;dashed=1;strokeColor=#64748B;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
