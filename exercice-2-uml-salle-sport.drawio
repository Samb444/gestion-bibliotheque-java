        <!-- Demande d'enregistrement de l'inscription -->
        <mxCell id="msg-enregistrer" value="enregistrer()" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;strokeColor=#9333EA;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#581C87;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
