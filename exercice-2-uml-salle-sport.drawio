        <!-- Confirmation finale de l'inscription -->
        <mxCell id="msg-confirmee" value="inscription confirmée" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;strokeWidth=1.5;strokeColor=#16A34A;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#15803D;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
