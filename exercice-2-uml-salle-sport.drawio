        <!-- Retour d'enregistrement -->
        <mxCell id="msg-enregistree" value="inscription enregistrée" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;strokeWidth=1.5;strokeColor=#9333EA;fontFamily=Helvetica;fontSize=12;fontColor=#581C87;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="913" y="560" as="sourcePoint" />
            <mxPoint x="407" y="560" as="targetPoint" />
