            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 4. RELATION ABONNEMENT(id_adherent) -> ADHERENT(id_adherent) -->
        <mxCell id="edge-abonn-adherent" value="&lt;b style=&quot;color:#0F766E; background-color:#CCFBF1; padding:2px 4px; border:1px solid #14B8A6; border-radius:3px;&quot;&gt;FK id_adherent → ADHERENT(id_adherent)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=block;endFill=1;startArrow=oval;startFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#0F766E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="table-abonnement" target="table-adherent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- PANNEAU INFERIEUR : SCHÉMA RELATIONNEL TEXTUEL FORMEL -->
        <mxCell id="box-formal-schema" value="&lt;b&gt;SCHÉMA RELATIONNEL TEXTUEL STANDARD (NOTATION RELATIONNELLE CODIFIÉE)&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="490" y="1005" width="640" height="445" as="geometry" />
        </mxCell>
        <mxCell id="box-formal-schema-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Représentation formelle en algèbre relationnelle :&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color:#16A34A;&quot;&gt;COACH&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_coach&lt;/b&gt;&lt;/u&gt; : INT, nom : VARCHAR(100), prenom : VARCHAR(100), specialite : VARCHAR(100) )&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color:#4F46E5;&quot;&gt;COURS&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_cours&lt;/b&gt;&lt;/u&gt; : INT, nom : VARCHAR(100), date : DATE, heure : TIME, capacite_max : INT, &lt;b style=&quot;color:#D97706;&quot;&gt;#id_coach&lt;/b&gt; : INT )&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#64748B;&quot;&gt;Contrainte : COURS.#id_coach référence COACH.id_coach&lt;/i&gt;&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color:#2563EB;&quot;&gt;ADHERENT&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_adherent&lt;/u&gt;&lt;/b&gt; : INT, nom : VARCHAR(100), prenom : VARCHAR(100), email : VARCHAR(100), telephone : VARCHAR(100) )&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color:#9333EA;&quot;&gt;INSCRIPTION&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_inscription&lt;/u&gt;&lt;/b&gt; : INT, date_inscription : DATE, statut : VARCHAR(100), &lt;b style=&quot;color:#D97706;&quot;&gt;#id_adherent&lt;/b&gt; : INT, &lt;b style=&quot;color:#D97706;&quot;&gt;#id_cours&lt;/b&gt; : INT )&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#64748B;&quot;&gt;Contraintes : INSCRIPTION.#id_adherent référence ADHERENT.id_adherent | INSCRIPTION.#id_cours référence COURS.id_cours&lt;/i&gt;&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color:#0D9488;&quot;&gt;ABONNEMENT&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_abonnement&lt;/u&gt;&lt;/b&gt; : INT, type : VARCHAR(100), date_debut : DATE, date_fin : DATE, statut : VARCHAR(100), &lt;b style=&quot;color:#D97706;&quot;&gt;#id_adherent&lt;/b&gt; : INT )&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#64748B;&quot;&gt;Contrainte : ABONNEMENT.#id_adherent référence ADHERENT.id_adherent&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;hr style=&quot;border:none; border-top:1px solid #CBD5E1;&quot;&gt;&lt;br&gt;&lt;b style=&quot;color:#0F172A;&quot;&gt;Conventions de notation appliquées :&lt;/b&gt;&lt;br&gt;• Les clés primaires sont &lt;u&gt;&lt;b&gt;soulignées et en gras&lt;/b&gt;&lt;/u&gt;.&lt;br&gt;• Les clés étrangères sont précédées du croisillon &lt;b style=&quot;color:#D97706;&quot;&gt;#&lt;/b&gt; (ou annotées FK).&lt;br&gt;• Tous les types sont strictement alignés sur les types natifs MySQL requis en Phase 3." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="box-formal-schema">
          <mxGeometry y="28" width="640" height="417" as="geometry" />
        </mxCell>

        <!-- ======================================================== -->
        <!-- COLONNE DROITE : INTÉGRITÉ RÉFÉRENTIELLE, 3FN & AUDIT    -->
        <!-- ======================================================== -->

        <!-- Carte 4 : Matrice d'intégrité référentielle (FK) -->
        <mxCell id="card-integrity" value="&lt;b&gt;4. MATRICE D&#39;INTÉGRITÉ RÉFÉRENTIELLE (FK)&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1190" y="110" width="390" height="440" as="geometry" />
        </mxCell>
        <mxCell id="card-integrity-content" value="&lt;table border=&quot;0&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;width:100%; font-size:10px; font-family:Helvetica; color:#1E293B;&quot;&gt;&#10;  &lt;tr style=&quot;background-color:#E2E8F0; font-weight:bold;&quot;&gt;&#10;    &lt;td&gt;Table Source (FK)&lt;/td&gt;&#10;    &lt;td&gt;Colonne FK&lt;/td&gt;&#10;    &lt;td&gt;Table Cible (PK)&lt;/td&gt;&#10;    &lt;td&gt;Colonne PK&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FEF3C7;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#4F46E5;&quot;&gt;COURS&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;id_coach&lt;/td&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#16A34A;&quot;&gt;COACH&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_coach&lt;/u&gt;&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#EDE9FE;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#9333EA;&quot;&gt;INSCRIPTION&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;id_cours&lt;/td&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#4F46E5;&quot;&gt;COURS&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_cours&lt;/u&gt;&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#DBEAFE;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#9333EA;&quot;&gt;INSCRIPTION&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;id_adherent&lt;/td&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#2563EB;&quot;&gt;ADHERENT&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_adherent&lt;/u&gt;&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#CCFBF1;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#0D9488;&quot;&gt;ABONNEMENT&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;id_adherent&lt;/td&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#2563EB;&quot;&gt;ADHERENT&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_adherent&lt;/u&gt;&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;&lt;/table&gt;&#10;&lt;br&gt;&#10;&lt;b style=&quot;color:#0F172A;&quot;&gt;Règles d&#39;intégrité relationnelle (MCD → MLD) :&lt;/b&gt;&lt;br&gt;&#10;• &lt;b&gt;COACH → COURS :&lt;/b&gt; Tout cours possède obligatoirement un coach référent (&lt;i&gt;id_coach NOT NULL&lt;/i&gt;). Un coach peut être référencé par 0 à N cours.&lt;br&gt;&#10;• &lt;b&gt;COURS → INSCRIPTION :&lt;/b&gt; Toute inscription est adossée à un cours existant (&lt;i&gt;id_cours NOT NULL&lt;/i&gt;).&lt;br&gt;&#10;• &lt;b&gt;ADHERENT → INSCRIPTION :&lt;/b&gt; Toute inscription est adossée à un adhérent existant (&lt;i&gt;id_adherent NOT NULL&lt;/i&gt;).&lt;br&gt;&#10;• &lt;b&gt;ADHERENT → ABONNEMENT :&lt;/b&gt; Tout abonnement est souscrit par un adhérent existant (&lt;i&gt;id_adherent NOT NULL&lt;/i&gt;).&lt;br&gt;&#10;• &lt;b&gt;Protection contre les orphelins :&lt;/b&gt; La cohérence des clés étrangères interdit l&#39;existence d&#39;une inscription ou d&#39;un abonnement sans adhérent valide." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-integrity">
          <mxGeometry y="28" width="390" height="412" as="geometry" />
        </mxCell>

        <!-- Carte 5 : Respect des Formes Normales (1FN, 2FN, 3FN) -->
        <mxCell id="card-norm" value="&lt;b&gt;5. CONFORMITÉ AUX FORMES NORMALES (3FN)&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1190" y="575" width="390" height="440" as="geometry" />
        </mxCell>
        <mxCell id="card-norm-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Démonstration de conformité 3FN :&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;1ère Forme Normale (1FN) :&lt;/b&gt;&lt;br&gt;Tous les attributs sont atomiques (indivisibles). Aucun tableau, attribut multivalué ni concaténation non normalisée (&lt;i&gt;nom&lt;/i&gt; et &lt;i&gt;prenom&lt;/i&gt; séparés, &lt;i&gt;date&lt;/i&gt; et &lt;i&gt;heure&lt;/i&gt; distincts). Chaque table possède une clé primaire identifiante.&lt;br&gt;&lt;br&gt;• &lt;b&gt;2ème Forme Normale (2FN) :&lt;/b&gt;&lt;br&gt;Le modèle est en 1FN et chaque clé primaire est simple (mono-attribut : &lt;i&gt;id_coach, id_cours, id_adherent, id_inscription, id_abonnement&lt;/i&gt;). Par définition, tout attribut non-clé dépend donc de la totalité de la clé primaire.&lt;br&gt;&lt;br&gt;• &lt;b&gt;3ème Forme Normale (3FN) :&lt;/b&gt;&lt;br&gt;Le modèle est en 2FN et il n&#39;existe aucune dépendance fonctionnelle transitive entre attributs non-clés :&lt;br&gt;- Dans COACH : nom, prenom, specialite dépendent uniquement de id_coach.&lt;br&gt;- Dans COURS : nom, date, heure, capacite_max, id_coach dépendent de id_cours.&lt;br&gt;- Dans ADHERENT : nom, prenom, email, telephone dépendent de id_adherent.&lt;br&gt;- Dans INSCRIPTION : date_inscription, statut, id_adherent, id_cours dépendent de id_inscription.&lt;br&gt;- Dans ABONNEMENT : type, date_debut, date_fin, statut, id_adherent dépendent de id_abonnement.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#16A34A;&quot;&gt;Conclusion : Le schéma est optimal, sans redondance ni anomalie de mise à jour.&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-norm">
          <mxGeometry y="28" width="390" height="412" as="geometry" />
        </mxCell>

        <!-- Carte 6 : Checklist de conformité Phase 2 -->
        <mxCell id="card-audit" value="&lt;b&gt;6. CHECKLIST DE CONFORMITÉ — PHASE 2&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1190" y="1040" width="390" height="440" as="geometry" />
        </mxCell>
        <mxCell id="card-audit-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Contrôle des critères obligatoires du MLD :&lt;/b&gt;&lt;br&gt;&lt;br&gt;✔ &lt;b&gt;Exactement 5 tables :&lt;/b&gt; COACH, COURS, ADHERENT, INSCRIPTION, ABONNEMENT.&lt;br&gt;✔ &lt;b&gt;Toutes les PK identifiées :&lt;/b&gt; id_coach, id_cours, id_adherent, id_inscription, id_abonnement.&lt;br&gt;✔ &lt;b&gt;Toutes les FK identifiées :&lt;/b&gt; COURS.id_coach, INSCRIPTION.id_adherent, INSCRIPTION.id_cours, ABONNEMENT.id_adherent.&lt;br&gt;✔ &lt;b&gt;Conformité stricte au MCD :&lt;/b&gt; Les 4 FK traduisent exactement les 4 associations (1,1) — (0,N).&lt;br&gt;✔ &lt;b&gt;Types MySQL explicites :&lt;/b&gt; INT, VARCHAR(100), DATE, TIME sur chaque colonne.&lt;br&gt;✔ &lt;b&gt;Aucune table supplémentaire :&lt;/b&gt; Pas de table administrateur, pas de table superflue.&lt;br&gt;✔ &lt;b&gt;Aucun lien direct ADHERENT ↔ COURS :&lt;/b&gt; Découplage complet via INSCRIPTION.&lt;br&gt;✔ &lt;b&gt;Aucune méthode UML :&lt;/b&gt; Modèle relationnel pur sans méthodes ni visibilités.&lt;br&gt;✔ &lt;b&gt;Aucun script SQL créé :&lt;/b&gt; Phase 2 purement logique (avant la Phase 3 SQL).&lt;br&gt;✔ &lt;b&gt;mcd-salle-sport.drawio intact :&lt;/b&gt; MCD d&#39;origine rigoureusement préservé.&lt;br&gt;✔ &lt;b&gt;Fichier dédié :&lt;/b&gt; mld-salle-sport.drawio créé et autonome." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-audit">
          <mxGeometry y="28" width="390" height="412" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
