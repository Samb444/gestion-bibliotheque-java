<mxfile host="Electron" modified="2026-10-06T14:15:00.000Z" agent="Antigravity MLD" version="21.0.0" type="device">
  <diagram id="diag-mld-salle-sport" name="MLD - Salle de Sport">
    <mxGraphModel dx="1600" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1540" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ======================================================== -->
        <!-- EN-TETE PRINCIPAL DU MLD                                 -->
        <!-- ======================================================== -->
        <mxCell id="mld-header" value="" style="rounded=1;arcSize=2;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=1;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1540" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mld-title" value="&lt;b style=&quot;font-size: 16px; color: #FFFFFF;&quot;&gt;MODÈLE LOGIQUE DE DONNÉES (MLD) — SYSTÈME DE GESTION DE SALLE DE SPORT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #94A3B8;&quot;&gt;Exercice 3 : Conception Relationnelle MySQL — Dérivation du MCD validé (Tables, Clés Primaires PK, Clés Étrangères FK &amp;amp; Types de Données)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="27" width="1050" height="55" as="geometry" />
        </mxCell>
        <mxCell id="mld-badge-status" value="&lt;b&gt;PHASE 2 — MLD RELATIONNEL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;5 Tables MySQL | 4 Clés Étrangères (FK)&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#1E293B;strokeColor=#38BDF8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#38BDF8;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1">
          <mxGeometry x="1330" y="32" width="230" height="45" as="geometry" />
        </mxCell>

        <!-- ======================================================== -->
        <!-- COLONNE GAUCHE : RÈGLES DE DÉRIVATION, DICTIONNAIRE & 3FN -->
        <!-- ======================================================== -->

        <!-- Carte 1 : Règles de dérivation Merise (MCD -> MLD) -->
        <mxCell id="card-derivation" value="&lt;b&gt;1. RÈGLES DE DÉRIVATION MCD → MLD&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="390" height="440" as="geometry" />
        </mxCell>
        <mxCell id="card-derivation-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Application stricte des règles Merise :&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Règle 1 : Transformation des entités&lt;/b&gt;&lt;br&gt;Chaque entité du MCD devient une table relationnelle dans le MLD. Ses attributs deviennent des colonnes typées et son identifiant unique devient la clé primaire (&lt;b&gt;PK&lt;/b&gt;).&lt;br&gt;&lt;br&gt;• &lt;b&gt;Règle 2 : Associations binaires (0,N) ↔ (1,1)&lt;/b&gt;&lt;br&gt;L&#39;identifiant de la table située côté &lt;b&gt;(0,N)&lt;/b&gt; migre comme clé étrangère (&lt;b&gt;FK&lt;/b&gt;) dans la table située côté &lt;b&gt;(1,1)&lt;/b&gt;.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Application concrète aux 4 associations :&lt;/b&gt;&lt;br&gt;1. &lt;i&gt;ENCADRER&lt;/i&gt; : COACH (0,N) → (1,1) COURS&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;⇒ Migration de &lt;b&gt;id_coach&lt;/b&gt; en FK dans &lt;b&gt;COURS&lt;/b&gt;.&lt;br&gt;2. &lt;i&gt;CONCERNER&lt;/i&gt; : COURS (0,N) → (1,1) INSCRIPTION&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;⇒ Migration de &lt;b&gt;id_cours&lt;/b&gt; en FK dans &lt;b&gt;INSCRIPTION&lt;/b&gt;.&lt;br&gt;3. &lt;i&gt;EFFECTUER&lt;/i&gt; : ADHERENT (0,N) → (1,1) INSCRIPTION&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;⇒ Migration de &lt;b&gt;id_adherent&lt;/b&gt; en FK dans &lt;b&gt;INSCRIPTION&lt;/b&gt;.&lt;br&gt;4. &lt;i&gt;SOUSCRIRE&lt;/i&gt; : ADHERENT (0,N) → (1,1) ABONNEMENT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;⇒ Migration de &lt;b&gt;id_adherent&lt;/b&gt; en FK dans &lt;b&gt;ABONNEMENT&lt;/b&gt;.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Aucune table d&#39;association créée :&lt;/b&gt;&lt;br&gt;Aucune association n&#39;étant de cardinalité (0,N) ↔ (0,N), le modèle ne requiert aucune table de jointure intermédiaire supplémentaire." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-derivation">
          <mxGeometry y="28" width="390" height="412" as="geometry" />
        </mxCell>

        <!-- Carte 2 : Dictionnaire des données & typage MySQL -->
        <mxCell id="card-types" value="&lt;b&gt;2. DICTIONNAIRE &amp;amp; TYPAGE MYSQL&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="575" width="390" height="440" as="geometry" />
        </mxCell>
        <mxCell id="card-types-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Standards de typage retenus :&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&quot;0&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;width:100%; font-size:10px; font-family:Helvetica; color:#1E293B;&quot;&gt;&#10;  &lt;tr style=&quot;background-color:#E2E8F0; font-weight:bold;&quot;&gt;&#10;    &lt;td&gt;Type SQL&lt;/td&gt;&#10;    &lt;td&gt;Usage &amp;amp; Colonnes&lt;/td&gt;&#10;    &lt;td&gt;Propriétés&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#F8FAFC;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#0284C7;&quot;&gt;INT&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;Toutes les PK (id_*) et FK, capacite_max&lt;/td&gt;&#10;    &lt;td&gt;Entier 4 octets, clé numérique indexée&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#F1F5F9;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#0D9488;&quot;&gt;VARCHAR(100)&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;nom, prenom, specialite, email, telephone&lt;/td&gt;&#10;    &lt;td&gt;Chaîne variable UTF-8 flexible&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#F8FAFC;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#7C3AED;&quot;&gt;VARCHAR(50)&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;statut, type (abonnement / inscription)&lt;/td&gt;&#10;    &lt;td&gt;Codes et états métiers normalisés&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#F1F5F9;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#EA580C;&quot;&gt;DATE&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;date (cours), date_inscription, date_debut, date_fin&lt;/td&gt;&#10;    &lt;td&gt;Format calendaire YYYY-MM-DD standard&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#F8FAFC;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#D97706;&quot;&gt;TIME&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;heure (horaire du cours)&lt;/td&gt;&#10;    &lt;td&gt;Format horaire HH:MM:SS standard&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;&lt;/table&gt;&#10;&lt;br&gt;&#10;&lt;b style=&quot;color:#0F172A;&quot;&gt;Justification d&#39;atomicité :&lt;/b&gt;&lt;br&gt;&#10;• Découplage strict de la &lt;i&gt;date&lt;/i&gt; (DATE) et de l&#39;&lt;i&gt;heure&lt;/i&gt; (TIME) pour un requêtage précis sans dépendance d&#39;un timestamp composite.&lt;br&gt;&#10;• Découplage nominal systématique (&lt;i&gt;nom&lt;/i&gt; et &lt;i&gt;prenom&lt;/i&gt; séparés).&lt;br&gt;&#10;• Format téléphone stocké en &lt;i&gt;VARCHAR(100)&lt;/i&gt; pour supporter les indicatifs internationaux (+33, 00...) sans perte de zéro initial." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-types">
          <mxGeometry y="28" width="390" height="412" as="geometry" />
        </mxCell>

        <!-- Carte 3 : Exclusion des redondances & intégrité conceptuelle -->
        <mxCell id="card-rules" value="&lt;b&gt;3. EXCLUSION DES REDONDANCES &amp;amp; RÈGLES&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="390" height="440" as="geometry" />
        </mxCell>
        <mxCell id="card-rules-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Garanties d&#39;architecture relationnelle :&lt;/b&gt;&lt;br&gt;&lt;br&gt;✔ &lt;b&gt;Aucune relation directe ADHERENT ↔ COURS :&lt;/b&gt;&lt;br&gt;Un adhérent ne référence jamais directement un cours, et un cours ne référence jamais un adhérent. Tout lien passe exclusivement par la table pivot métier &lt;b&gt;INSCRIPTION&lt;/b&gt; (&lt;i&gt;id_adherent, id_cours&lt;/i&gt;). Cela élimine tout risque d&#39;incohérence ou de redondance.&lt;br&gt;&lt;br&gt;✔ &lt;b&gt;Aucune table ADMINISTRATEUR :&lt;/b&gt;&lt;br&gt;L&#39;administrateur est un utilisateur de gestion du logiciel (acteur applicatif), pas une table de données métier du club de sport.&lt;br&gt;&lt;br&gt;✔ &lt;b&gt;Découplage INSCRIPTION et ABONNEMENT :&lt;/b&gt;&lt;br&gt;Ces deux tables sont indépendantes et rattachées directement à l&#39;adhérent, permettant à un adhérent d&#39;avoir un historique d&#39;abonnements sans impacter ses inscriptions à un cours spécifique.&lt;br&gt;&lt;br&gt;✔ &lt;b&gt;Pas de méthodes objet ni notations UML :&lt;/b&gt;&lt;br&gt;Le diagramme est un pur MLD relationnel (tables, attributs, PK, FK). Aucune opération logicielle ni visibilité (+/-/#) n&#39;y figure." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-rules">
          <mxGeometry y="28" width="390" height="412" as="geometry" />
        </mxCell>

        <!-- ======================================================== -->
        <!-- COLONNE CENTRALE : LE SCHÉMA RELATIONNEL (5 TABLES + FK)  -->
        <!-- ======================================================== -->

        <!-- Conteneur global du MLD -->
        <mxCell id="mld-canvas-container" value="&lt;b&gt;SCHÉMA RELATIONNEL DU MLD (TABLES, COLONNES, CLÉS &amp;amp; DÉPENDANCES)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontFamily=Helvetica;fontSize=12;fontStyle=1;align=center;horizontal=1;swimlaneFillColor=#FFFFFF;fillColor=#F8FAFC;fontColor=#475569;strokeColor=#CBD5E1;strokeWidth=1.5;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="460" y="110" width="700" height="1370" as="geometry" />
        </mxCell>

        <!-- TABLE 1 : COACH -->
        <mxCell id="table-coach" value="&lt;b&gt;TABLE : COACH&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=4;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="490" y="160" width="290" height="165" as="geometry" />
        </mxCell>
        <mxCell id="table-coach-fields" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica; font-size:11px;&quot;&gt;&#10;  &lt;tr style=&quot;background-color:#F0FDF4; border-bottom:1px solid #BBF7D0;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; font-weight:bold; color:#166534;&quot;&gt;&lt;span style=&quot;color:#16A34A;&quot;&gt;[PK]&lt;/span&gt; &lt;u&gt;id_coach&lt;/u&gt;&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; font-weight:bold; color:#15803D;&quot;&gt;INT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;nom&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;prenom&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;specialite&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5],[0.5,0],[0.5,1]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="table-coach">
          <mxGeometry y="32" width="290" height="133" as="geometry" />
        </mxCell>

        <!-- TABLE 2 : COURS -->
        <mxCell id="table-cours" value="&lt;b&gt;TABLE : COURS&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=4;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#312E81;" vertex="1" parent="1">
          <mxGeometry x="840" y="160" width="290" height="215" as="geometry" />
        </mxCell>
        <mxCell id="table-cours-fields" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica; font-size:11px;&quot;&gt;&#10;  &lt;tr style=&quot;background-color:#F5F3FF; border-bottom:1px solid #DDD6FE;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; font-weight:bold; color:#4338CA;&quot;&gt;&lt;span style=&quot;color:#4F46E5;&quot;&gt;[PK]&lt;/span&gt; &lt;u&gt;id_cours&lt;/u&gt;&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; font-weight:bold; color:#4338CA;&quot;&gt;INT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;nom&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;date&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#EA580C; font-weight:bold;&quot;&gt;DATE&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;heure&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#D97706; font-weight:bold;&quot;&gt;TIME&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;capacite_max&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#64748B;&quot;&gt;INT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FEF3C7; border-top:1px solid #FDE68A;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; font-weight:bold; color:#92400E;&quot;&gt;&lt;span style=&quot;color:#D97706;&quot;&gt;[FK]&lt;/span&gt; id_coach&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; font-weight:bold; color:#B45309;&quot;&gt;INT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5],[0.5,0],[0.5,1]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="table-cours">
          <mxGeometry y="32" width="290" height="183" as="geometry" />
        </mxCell>

        <!-- TABLE 3 : ADHERENT -->
        <mxCell id="table-adherent" value="&lt;b&gt;TABLE : ADHERENT&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=4;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="490" y="470" width="290" height="195" as="geometry" />
        </mxCell>
        <mxCell id="table-adherent-fields" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica; font-size:11px;&quot;&gt;&#10;  &lt;tr style=&quot;background-color:#DBEAFE; border-bottom:1px solid #BFDBFE;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; font-weight:bold; color:#1E40AF;&quot;&gt;&lt;span style=&quot;color:#2563EB;&quot;&gt;[PK]&lt;/span&gt; &lt;u&gt;id_adherent&lt;/u&gt;&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; font-weight:bold; color:#1D4ED8;&quot;&gt;INT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;nom&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;prenom&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;email&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;telephone&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5],[0.5,0],[0.5,1]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="table-adherent">
          <mxGeometry y="32" width="290" height="163" as="geometry" />
        </mxCell>

        <!-- TABLE 4 : INSCRIPTION -->
        <mxCell id="table-inscription" value="&lt;b&gt;TABLE : INSCRIPTION&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=4;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#581C87;" vertex="1" parent="1">
          <mxGeometry x="840" y="470" width="290" height="195" as="geometry" />
        </mxCell>
        <mxCell id="table-inscription-fields" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica; font-size:11px;&quot;&gt;&#10;  &lt;tr style=&quot;background-color:#F3E8FF; border-bottom:1px solid #E9D5FF;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; font-weight:bold; color:#7E22CE;&quot;&gt;&lt;span style=&quot;color:#9333EA;&quot;&gt;[PK]&lt;/span&gt; &lt;u&gt;id_inscription&lt;/u&gt;&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; font-weight:bold; color:#7E22CE;&quot;&gt;INT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;date_inscription&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#EA580C; font-weight:bold;&quot;&gt;DATE&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;statut&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#7C3AED; font-weight:bold;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FEF3C7; border-top:1px solid #FDE68A;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; font-weight:bold; color:#92400E;&quot;&gt;&lt;span style=&quot;color:#D97706;&quot;&gt;[FK]&lt;/span&gt; id_adherent&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; font-weight:bold; color:#B45309;&quot;&gt;INT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FEF3C7; border-top:1px solid #FDE68A;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; font-weight:bold; color:#92400E;&quot;&gt;&lt;span style=&quot;color:#D97706;&quot;&gt;[FK]&lt;/span&gt; id_cours&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; font-weight:bold; color:#B45309;&quot;&gt;INT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5],[0.5,0],[0.5,1]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="table-inscription">
          <mxGeometry y="32" width="290" height="163" as="geometry" />
        </mxCell>

        <!-- TABLE 5 : ABONNEMENT -->
        <mxCell id="table-abonnement" value="&lt;b&gt;TABLE : ABONNEMENT&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=4;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#115E59;" vertex="1" parent="1">
          <mxGeometry x="490" y="750" width="290" height="215" as="geometry" />
        </mxCell>
        <mxCell id="table-abonnement-fields" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica; font-size:11px;&quot;&gt;&#10;  &lt;tr style=&quot;background-color:#CCFBF1; border-bottom:1px solid #99F6E4;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; font-weight:bold; color:#0F766E;&quot;&gt;&lt;span style=&quot;color:#0D9488;&quot;&gt;[PK]&lt;/span&gt; &lt;u&gt;id_abonnement&lt;/u&gt;&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; font-weight:bold; color:#0F766E;&quot;&gt;INT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;type&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#7C3AED; font-weight:bold;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;date_debut&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#EA580C; font-weight:bold;&quot;&gt;DATE&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;date_fin&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#EA580C; font-weight:bold;&quot;&gt;DATE&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; color:#1E293B;&quot;&gt;statut&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; color:#7C3AED; font-weight:bold;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FEF3C7; border-top:1px solid #FDE68A;&quot;&gt;&#10;    &lt;td style=&quot;padding:5px 8px; font-weight:bold; color:#92400E;&quot;&gt;&lt;span style=&quot;color:#D97706;&quot;&gt;[FK]&lt;/span&gt; id_adherent&lt;/td&gt;&#10;    &lt;td style=&quot;padding:5px 8px; text-align:right; font-weight:bold; color:#B45309;&quot;&gt;INT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5],[0.5,0],[0.5,1]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="table-abonnement">
          <mxGeometry y="32" width="290" height="183" as="geometry" />
        </mxCell>

        <!-- PANNEAU LÉGENDE DES RELATIONS DANS LE CANVAS -->
        <mxCell id="box-legend" value="&lt;b&gt;LÉGENDE DES RELATIONS &amp;amp; CLÉS&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=4;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="840" y="750" width="290" height="215" as="geometry" />
        </mxCell>
        <mxCell id="box-legend-content" value="&lt;b style=&quot;color:#92400E;&quot;&gt;Signification des symboles relationnels :&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color:#16A34A;&quot;&gt;[PK] (Clé Primaire)&lt;/b&gt; : Identifiant unique non-nul de chaque enregistrement. Génère un index primaire d&#39;unicité.&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color:#D97706;&quot;&gt;[FK] (Clé Étrangère)&lt;/b&gt; : Attribut qui référence la clé primaire d&#39;une autre table pour garantir l&#39;intégrité référentielle.&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color:#2563EB;&quot;&gt;Flèches relationnelles :&lt;/b&gt;&lt;br&gt;Chaque flèche part de la &lt;b&gt;clé étrangère (FK)&lt;/b&gt; vers la &lt;b&gt;clé primaire (PK)&lt;/b&gt; référencée, traduisant la multiplicité relationnelle &lt;b&gt;N : 1&lt;/b&gt; (ou 1:N dans le sens de la dépendance)." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10.5;fontColor=#451A03;" vertex="1" parent="box-legend">
          <mxGeometry y="26" width="290" height="189" as="geometry" />
        </mxCell>

        <!-- ======================================================== -->
        <!-- CONNECTEURS RELATIONNELS ENTRE TABLES (FK -> PK)          -->
        <!-- ======================================================== -->

        <!-- 1. RELATION COURS(id_coach) -> COACH(id_coach) -->
        <mxCell id="edge-cours-coach" value="&lt;b style=&quot;color:#B45309; background-color:#FEF3C7; padding:2px 4px; border:1px solid #F59E0B; border-radius:3px;&quot;&gt;FK id_coach → COACH(id_coach)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;startArrow=oval;startFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#B45309;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.88;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="table-cours" target="table-coach">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="815" y="350" />
              <mxPoint x="815" y="218" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 2. RELATION INSCRIPTION(id_cours) -> COURS(id_cours) -->
        <mxCell id="edge-insc-cours" value="&lt;b style=&quot;color:#7C3AED; background-color:#EDE9FE; padding:2px 4px; border:1px solid #8B5CF6; border-radius:3px;&quot;&gt;FK id_cours → COURS(id_cours)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;startArrow=oval;startFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#7C3AED;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="table-inscription" target="table-cours">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. RELATION INSCRIPTION(id_adherent) -> ADHERENT(id_adherent) -->
        <mxCell id="edge-insc-adherent" value="&lt;b style=&quot;color:#1D4ED8; background-color:#DBEAFE; padding:2px 4px; border:1px solid #3B82F6; border-radius:3px;&quot;&gt;FK id_adherent → ADHERENT(id_adherent)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;startArrow=oval;startFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#1D4ED8;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="table-inscription" target="table-adherent">
