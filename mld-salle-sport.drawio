          <mxGeometry x="510" y="1220" width="640" height="550" as="geometry" />
        </mxCell>
        <mxCell id="box-formal-schema-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Représentation formelle en algèbre relationnelle :&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color:#16A34A;&quot;&gt;COACH&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_coach&lt;/b&gt;&lt;/u&gt; : INT, nom : VARCHAR(100), prenom : VARCHAR(100), specialite : VARCHAR(100) )&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color:#4F46E5;&quot;&gt;COURS&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_cours&lt;/b&gt;&lt;/u&gt; : INT, nom : VARCHAR(100), date : DATE, heure : TIME, capacite_max : INT, &lt;b style=&quot;color:#D97706;&quot;&gt;#id_coach&lt;/b&gt; : INT )&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#64748B;&quot;&gt;FK : COURS.#id_coach → COACH.id_coach&lt;/i&gt;&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color:#2563EB;&quot;&gt;ADHERENT&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_adherent&lt;/u&gt;&lt;/b&gt; : INT, nom : VARCHAR(100), prenom : VARCHAR(100), email : VARCHAR(100), telephone : VARCHAR(100) )&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color:#9333EA;&quot;&gt;INSCRIPTION&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_inscription&lt;/u&gt;&lt;/b&gt; : INT, date_inscription : DATE, statut : VARCHAR(100), &lt;b style=&quot;color:#D97706;&quot;&gt;#id_adherent&lt;/b&gt; : INT, &lt;b style=&quot;color:#D97706;&quot;&gt;#id_cours&lt;/b&gt; : INT )&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#64748B;&quot;&gt;FK : INSCRIPTION.#id_adherent → ADHERENT.id_adherent | INSCRIPTION.#id_cours → COURS.id_cours&lt;/i&gt;&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color:#DB2777;&quot;&gt;PRESENCE&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_presence&lt;/u&gt;&lt;/b&gt; : INT, date_presence : DATE, statut_presence : VARCHAR(20), &lt;b style=&quot;color:#D97706;&quot;&gt;#id_inscription&lt;/b&gt; : INT )&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#64748B;&quot;&gt;FK/UK : PRESENCE.#id_inscription → INSCRIPTION.id_inscription (UNIQUE)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color:#0D9488;&quot;&gt;ABONNEMENT&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_abonnement&lt;/u&gt;&lt;/b&gt; : INT, type : VARCHAR(100), date_debut : DATE, date_fin : DATE, statut : VARCHAR(100), &lt;b style=&quot;color:#D97706;&quot;&gt;#id_adherent&lt;/b&gt; : INT )&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#64748B;&quot;&gt;FK : ABONNEMENT.#id_adherent → ADHERENT.id_adherent&lt;/i&gt;&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;color:#D97706;&quot;&gt;PAIEMENT&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_paiement&lt;/u&gt;&lt;/b&gt; : INT, montant : DECIMAL(10,2), date_paiement : DATE, mode_paiement : VARCHAR(50), statut : VARCHAR(50), &lt;b style=&quot;color:#0D9488;&quot;&gt;#id_abonnement&lt;/b&gt; : INT )&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#64748B;&quot;&gt;FK : PAIEMENT.#id_abonnement → ABONNEMENT.id_abonnement&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;hr style=&quot;border:none; border-top:1px solid #CBD5E1;&quot;&gt;&lt;br&gt;&lt;b style=&quot;color:#0F172A;&quot;&gt;Conventions de notation appliquées :&lt;/b&gt;&lt;br&gt;• Les clés primaires sont &lt;u&gt;&lt;b&gt;soulignées et en gras&lt;/b&gt;&lt;/u&gt;.&lt;br&gt;• Les clés étrangères sont précédées du croisillon &lt;b style=&quot;color:#D97706;&quot;&gt;#&lt;/b&gt; (ou annotées FK).&lt;br&gt;• Tous les types sont strictement alignés sur les types réels MariaDB/MySQL." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="box-formal-schema">
          <mxGeometry y="28" width="640" height="522" as="geometry" />
        </mxCell>

        <!-- ======================================================== -->
        <!-- COLONNE DROITE : INTÉGRITÉ RÉFÉRENTIELLE, 3FN & AUDIT    -->
        <!-- ======================================================== -->

        <!-- Carte 4 : Matrice d'intégrité référentielle (FK) -->
        <mxCell id="card-integrity" value="&lt;b&gt;4. MATRICE D&#39;INTÉGRITÉ RÉFÉRENTIELLE (FK)&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1210" y="110" width="450" height="470" as="geometry" />
        </mxCell>
        <mxCell id="card-integrity-content" value="&lt;table border=&quot;0&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;width:100%; font-size:10px; font-family:Helvetica; color:#1E293B;&quot;&gt;&#10;  &lt;tr style=&quot;background-color:#E2E8F0; font-weight:bold;&quot;&gt;&#10;    &lt;td&gt;Table Source (FK)&lt;/td&gt;&#10;    &lt;td&gt;Colonne FK&lt;/td&gt;&#10;    &lt;td&gt;Table Cible (PK)&lt;/td&gt;&#10;    &lt;td&gt;Colonne PK&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FEF3C7;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#4F46E5;&quot;&gt;COURS&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;id_coach&lt;/td&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#16A34A;&quot;&gt;COACH&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_coach&lt;/u&gt;&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#EDE9FE;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#9333EA;&quot;&gt;INSCRIPTION&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;id_cours&lt;/td&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#4F46E5;&quot;&gt;COURS&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_cours&lt;/u&gt;&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#DBEAFE;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#9333EA;&quot;&gt;INSCRIPTION&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;id_adherent&lt;/td&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#2563EB;&quot;&gt;ADHERENT&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_adherent&lt;/u&gt;&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FCE7F3;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#DB2777;&quot;&gt;PRESENCE&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;id_inscription&lt;/td&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#9333EA;&quot;&gt;INSCRIPTION&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_inscription&lt;/u&gt;&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#CCFBF1;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#0D9488;&quot;&gt;ABONNEMENT&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;id_adherent&lt;/td&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#2563EB;&quot;&gt;ADHERENT&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_adherent&lt;/u&gt;&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FEF3C7;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#D97706;&quot;&gt;PAIEMENT&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;id_abonnement&lt;/td&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#0D9488;&quot;&gt;ABONNEMENT&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;&lt;u&gt;id_abonnement&lt;/u&gt;&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;&lt;/table&gt;&#10;&lt;br&gt;&#10;&lt;b style=&quot;color:#0F172A;&quot;&gt;Règles d&#39;intégrité relationnelle (MCD → MLD) :&lt;/b&gt;&lt;br&gt;&#10;• &lt;b&gt;COACH → COURS :&lt;/b&gt; Tout cours possède un coach référent (&lt;i&gt;id_coach NOT NULL&lt;/i&gt;).&lt;br&gt;&#10;• &lt;b&gt;COURS → INSCRIPTION :&lt;/b&gt; Toute inscription est adossée à un cours existant.&lt;br&gt;&#10;• &lt;b&gt;ADHERENT → INSCRIPTION :&lt;/b&gt; Toute inscription est adossée à un adhérent valide.&lt;br&gt;&#10;• &lt;b&gt;INSCRIPTION → PRESENCE :&lt;/b&gt; Tout émargement certifie une inscription réelle (contrainte UNIQUE : 1 émargement max par inscription).&lt;br&gt;&#10;• &lt;b&gt;ADHERENT → ABONNEMENT :&lt;/b&gt; Tout abonnement est souscrit par un adhérent existant.&lt;br&gt;&#10;• &lt;b&gt;ABONNEMENT → PAIEMENT :&lt;/b&gt; Tout paiement est rattaché à un abonnement valide.&lt;br&gt;&#10;• &lt;b&gt;Protection contre les orphelins :&lt;/b&gt; ON DELETE RESTRICT / ON UPDATE CASCADE." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-integrity">
          <mxGeometry y="28" width="450" height="442" as="geometry" />
        </mxCell>

        <!-- Carte 5 : Respect des Formes Normales (3FN) -->
        <mxCell id="card-norm" value="&lt;b&gt;5. CONFORMITÉ AUX FORMES NORMALES (3FN)&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1210" y="605" width="450" height="480" as="geometry" />
        </mxCell>
        <mxCell id="card-norm-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Démonstration formelle de conformité 3FN :&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;1ère Forme Normale (1FN) :&lt;/b&gt;&lt;br&gt;Tous les attributs sont atomiques. Clés primaires clairement identifiées pour les 7 tables.&lt;br&gt;&lt;br&gt;• &lt;b&gt;2ème Forme Normale (2FN) :&lt;/b&gt;&lt;br&gt;Toutes les clés primaires sont simples (mono-attribut : &lt;i&gt;id_coach, id_cours, id_adherent, id_inscription, id_presence, id_abonnement, id_paiement&lt;/i&gt;). Tout attribut non-clé dépend donc de la totalité de la clé primaire.&lt;br&gt;&lt;br&gt;• &lt;b&gt;3ème Forme Normale (3FN) :&lt;/b&gt;&lt;br&gt;Aucune dépendance fonctionnelle transitive entre attributs non-clés :&lt;br&gt;- Dans COACH : nom, prenom, specialite dépendent uniquement de id_coach.&lt;br&gt;- Dans COURS : nom, date, heure, capacite_max, id_coach dépendent de id_cours.&lt;br&gt;- Dans ADHERENT : nom, prenom, email, telephone dépendent de id_adherent.&lt;br&gt;- Dans INSCRIPTION : date_inscription, statut, id_adherent, id_cours dépendent de id_inscription.&lt;br&gt;- Dans PRESENCE : date_presence, statut_presence, id_inscription dépendent de id_presence.&lt;br&gt;- Dans ABONNEMENT : type, date_debut, date_fin, statut, id_adherent dépendent de id_abonnement.&lt;br&gt;- Dans PAIEMENT : montant, date_paiement, mode_paiement, statut, id_abonnement dépendent de id_paiement.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#16A34A;&quot;&gt;Conclusion : Aucune redondance, anomalies d&#39;insertion/suppression éliminées.&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-norm">
          <mxGeometry y="28" width="450" height="452" as="geometry" />
        </mxCell>

        <!-- Carte 6 : Checklist de conformité Phase 2 -->
        <mxCell id="card-audit" value="&lt;b&gt;6. CHECKLIST DE CONFORMITÉ GLOBALE — MLD&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1210" y="1110" width="450" height="690" as="geometry" />
        </mxCell>
        <mxCell id="card-audit-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Contrôle des critères obligatoires du MLD :&lt;/b&gt;&lt;br&gt;&lt;br&gt;✔ &lt;b&gt;Exactement 7 tables :&lt;/b&gt; COACH, COURS, ADHERENT, INSCRIPTION, PRESENCE, ABONNEMENT, PAIEMENT.&lt;br&gt;✔ &lt;b&gt;Toutes les PK identifiées :&lt;/b&gt; id_coach, id_cours, id_adherent, id_inscription, id_presence, id_abonnement, id_paiement.&lt;br&gt;✔ &lt;b&gt;Toutes les 6 FK identifiées :&lt;/b&gt; COURS.id_coach, INSCRIPTION.id_adherent, INSCRIPTION.id_cours, PRESENCE.id_inscription, ABONNEMENT.id_adherent, PAIEMENT.id_abonnement.&lt;br&gt;✔ &lt;b&gt;Conformité stricte au MCD Merise :&lt;/b&gt; Respect des dérivations de cardinalités.&lt;br&gt;✔ &lt;b&gt;Types MySQL précis :&lt;/b&gt; INT, DECIMAL(10,2), VARCHAR(100), VARCHAR(50), VARCHAR(20), DATE, TIME.&lt;br&gt;✔ &lt;b&gt;Aucune table superflue :&lt;/b&gt; Découplage de l&#39;administrateur.&lt;br&gt;✔ &lt;b&gt;Absence de chemins redondants :&lt;/b&gt; Tout lien respecte la 3FN.&lt;br&gt;✔ &lt;b&gt;Fichier autonome :&lt;/b&gt; mld-salle-sport.drawio mis à jour avec rigueur." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-audit">
          <mxGeometry y="28" width="450" height="662" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
