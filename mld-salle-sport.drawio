<mxfile host="Electron" modified="2026-10-06T15:25:00.000Z" agent="Antigravity MLD" version="21.0.0" type="device">
  <diagram id="diag-mld-salle-sport" name="MLD - Salle de Sport">
    <mxGraphModel dx="1800" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ======================================================== -->
        <!-- EN-TETE PRINCIPAL DU MLD                                 -->
        <!-- ======================================================== -->
        <mxCell id="mld-header" value="" style="rounded=1;arcSize=2;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=1;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1620" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mld-title" value="&lt;b style=&quot;font-size: 16px; color: #FFFFFF;&quot;&gt;MODÈLE LOGIQUE DE DONNÉES (MLD) — SYSTÈME DE GESTION DE SALLE DE SPORT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #94A3B8;&quot;&gt;Exercice 3 : Conception Relationnelle MySQL — Schéma Complet avec Abonnements, Inscriptions, Présences et Paiements (Tables, PK, FK, Types)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="27" width="1120" height="55" as="geometry" />
        </mxCell>
        <mxCell id="mld-badge-status" value="&lt;b&gt;PHASE 2 (RÉVISÉE) — MLD RELATIONNEL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;7 Tables MySQL | 6 Clés Étrangères (FK)&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#1E293B;strokeColor=#38BDF8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#38BDF8;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1">
          <mxGeometry x="1390" y="32" width="250" height="45" as="geometry" />
        </mxCell>

        <!-- ======================================================== -->
        <!-- COLONNE GAUCHE : RÈGLES DE DÉRIVATION, DICTIONNAIRE & 3FN -->
        <!-- ======================================================== -->

        <!-- Carte 1 : Règles de dérivation Merise (MCD -> MLD) -->
        <mxCell id="card-derivation" value="&lt;b&gt;1. RÈGLES DE DÉRIVATION MCD → MLD&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="410" height="470" as="geometry" />
        </mxCell>
        <mxCell id="card-derivation-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Application stricte des règles Merise :&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Règle 1 : Transformation des entités&lt;/b&gt;&lt;br&gt;Chaque entité du MCD devient une table relationnelle dans le MLD. Ses attributs deviennent des colonnes typées et son identifiant unique devient la clé primaire (&lt;b&gt;PK&lt;/b&gt;).&lt;br&gt;&lt;br&gt;• &lt;b&gt;Règle 2 : Associations binaires (0,N) ↔ (1,1)&lt;/b&gt;&lt;br&gt;L&#39;identifiant du côté &lt;b&gt;(0,N)&lt;/b&gt; migre comme clé étrangère (&lt;b&gt;FK&lt;/b&gt;) dans la table du côté &lt;b&gt;(1,1)&lt;/b&gt;.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Application concrète aux 6 associations :&lt;/b&gt;&lt;br&gt;1. &lt;i&gt;ENCADRER&lt;/i&gt; : COACH (0,N) → (1,1) COURS&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;⇒ Migration de &lt;b&gt;id_coach&lt;/b&gt; en FK dans &lt;b&gt;COURS&lt;/b&gt;.&lt;br&gt;2. &lt;i&gt;CONCERNER&lt;/i&gt; : COURS (0,N) → (1,1) INSCRIPTION&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;⇒ Migration de &lt;b&gt;id_cours&lt;/b&gt; en FK dans &lt;b&gt;INSCRIPTION&lt;/b&gt;.&lt;br&gt;3. &lt;i&gt;EFFECTUER&lt;/i&gt; : ADHERENT (0,N) → (1,1) INSCRIPTION&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;⇒ Migration de &lt;b&gt;id_adherent&lt;/b&gt; en FK dans &lt;b&gt;INSCRIPTION&lt;/b&gt;.&lt;br&gt;4. &lt;i&gt;SOUSCRIRE&lt;/i&gt; : ADHERENT (0,N) → (1,1) ABONNEMENT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;⇒ Migration de &lt;b&gt;id_adherent&lt;/b&gt; en FK dans &lt;b&gt;ABONNEMENT&lt;/b&gt;.&lt;br&gt;5. &lt;i&gt;REGLER&lt;/i&gt; : ABONNEMENT (0,N) → (1,1) PAIEMENT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;⇒ Migration de &lt;b&gt;id_abonnement&lt;/b&gt; en FK dans &lt;b&gt;PAIEMENT&lt;/b&gt;.&lt;br&gt;6. &lt;i&gt;EMARGER&lt;/i&gt; : INSCRIPTION (0,1) → (1,1) PRESENCE&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;⇒ Migration de &lt;b&gt;id_inscription&lt;/b&gt; en FK UNIQUE dans &lt;b&gt;PRESENCE&lt;/b&gt;." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-derivation">
          <mxGeometry y="28" width="410" height="442" as="geometry" />
        </mxCell>

        <!-- Carte 2 : Dictionnaire des données & typage MySQL -->
        <mxCell id="card-types" value="&lt;b&gt;2. DICTIONNAIRE &amp;amp; TYPAGE MYSQL&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="605" width="410" height="480" as="geometry" />
        </mxCell>
        <mxCell id="card-types-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Standards de typage retenus :&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&quot;0&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;width:100%; font-size:10px; font-family:Helvetica; color:#1E293B;&quot;&gt;&#10;  &lt;tr style=&quot;background-color:#E2E8F0; font-weight:bold;&quot;&gt;&#10;    &lt;td&gt;Type SQL&lt;/td&gt;&#10;    &lt;td&gt;Usage &amp;amp; Colonnes&lt;/td&gt;&#10;    &lt;td&gt;Propriétés&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#F8FAFC;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#0284C7;&quot;&gt;INT&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;Toutes les PK (id_*) et FK, capacite_max&lt;/td&gt;&#10;    &lt;td&gt;Entier 4 octets, clé numérique indexée&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#F1F5F9;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#D97706;&quot;&gt;DECIMAL(10,2)&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;montant (PAIEMENT)&lt;/td&gt;&#10;    &lt;td&gt;Précision financière exacte en FCFA&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#F8FAFC;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#0D9488;&quot;&gt;VARCHAR(100)&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;nom, prenom, specialite, email, telephone, type&lt;/td&gt;&#10;    &lt;td&gt;Chaîne variable UTF-8 flexible&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#F1F5F9;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#7C3AED;&quot;&gt;VARCHAR(50)&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;statut, mode_paiement, statut_presence&lt;/td&gt;&#10;    &lt;td&gt;Codes et états métiers normalisés&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#F8FAFC;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#EA580C;&quot;&gt;DATE&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;date, date_inscription, date_debut, date_fin, date_paiement, date_presence&lt;/td&gt;&#10;    &lt;td&gt;Format calendaire YYYY-MM-DD standard&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#F1F5F9;&quot;&gt;&#10;    &lt;td&gt;&lt;b style=&quot;color:#D97706;&quot;&gt;TIME&lt;/b&gt;&lt;/td&gt;&#10;    &lt;td&gt;heure (horaire du cours)&lt;/td&gt;&#10;    &lt;td&gt;Format horaire HH:MM:SS standard&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;&lt;/table&gt;&#10;&lt;br&gt;&#10;&lt;b style=&quot;color:#0F172A;&quot;&gt;Règles d&#39;intégrité :&lt;/b&gt;&lt;br&gt;&#10;• &lt;i&gt;DECIMAL(10,2)&lt;/i&gt; au lieu de FLOAT/DOUBLE pour garantir l&#39;exactitude des calculs financiers d&#39;encaissement sans erreur d&#39;arrondi binaire.&lt;br&gt;&#10;• Découplage temporel DATE / TIME préservé.&lt;br&gt;&#10;• Clé UNIQUE sur &lt;i&gt;INSCRIPTION(id_adherent, id_cours)&lt;/i&gt; et &lt;i&gt;PRESENCE(id_inscription)&lt;/i&gt;." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-types">
          <mxGeometry y="28" width="410" height="452" as="geometry" />
        </mxCell>

        <!-- Carte 3 : Exclusion des redondances & règles -->
        <mxCell id="card-rules" value="&lt;b&gt;3. EXCLUSION DES REDONDANCES &amp;amp; RÈGLES&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="1110" width="410" height="690" as="geometry" />
        </mxCell>
        <mxCell id="card-rules-content" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Garanties d&#39;architecture relationnelle :&lt;/b&gt;&lt;br&gt;&lt;br&gt;✔ &lt;b&gt;Aucune duplication ADHERENT dans PRESENCE :&lt;/b&gt;&lt;br&gt;La table PRESENCE référence exclusivement &lt;i&gt;id_inscription&lt;/i&gt;. La jointure avec INSCRIPTION permet de retrouver immédiatement l&#39;adhérent et le cours, sans stocker redondamment &lt;i&gt;id_adherent&lt;/i&gt; ni &lt;i&gt;id_cours&lt;/i&gt; dans PRESENCE.&lt;br&gt;&lt;br&gt;✔ &lt;b&gt;Aucune duplication ADHERENT dans PAIEMENT :&lt;/b&gt;&lt;br&gt;La table PAIEMENT référence &lt;i&gt;id_abonnement&lt;/i&gt;, qui contient déjà &lt;i&gt;id_adherent&lt;/i&gt;. Cela garantit une 3FN exemplaire sans risque de désynchronisation contractuelle.&lt;br&gt;&lt;br&gt;✔ &lt;b&gt;Découplage INSCRIPTION et ABONNEMENT :&lt;/b&gt;&lt;br&gt;Deux axes distincts rattachés à ADHERENT : gestion des séances d&#39;entraînement d&#39;une part, et gestion contractuelle et financière d&#39;autre part.&lt;br&gt;&lt;br&gt;✔ &lt;b&gt;Absence de table ADMINISTRATEUR :&lt;/b&gt; Acteur système logiciel externe à la base de données métier." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="card-rules">
          <mxGeometry y="28" width="410" height="662" as="geometry" />
        </mxCell>

        <!-- ======================================================== -->
        <!-- COLONNE CENTRALE : LE SCHÉMA RELATIONNEL (7 TABLES + FK)  -->
        <!-- ======================================================== -->

        <!-- Conteneur global du MLD -->
        <mxCell id="mld-canvas-container" value="&lt;b&gt;SCHÉMA RELATIONNEL DU MLD (TABLES, COLONNES, CLÉS &amp;amp; DÉPENDANCES)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontFamily=Helvetica;fontSize=12;fontStyle=1;align=center;horizontal=1;swimlaneFillColor=#FFFFFF;fillColor=#F8FAFC;fontColor=#475569;strokeColor=#CBD5E1;strokeWidth=1.5;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="480" y="110" width="700" height="1690" as="geometry" />
        </mxCell>

        <!-- TABLE 1 : COACH -->
        <mxCell id="table-coach" value="&lt;b&gt;TABLE : COACH&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=4;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="510" y="150" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table-coach-fields" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica; font-size:11px;&quot;&gt;&#10;  &lt;tr style=&quot;background-color:#F0FDF4; border-bottom:1px solid #BBF7D0;&quot;&gt;&#10;    &lt;td style=&quot;padding:4px 8px; font-weight:bold; color:#166534;&quot;&gt;&lt;span style=&quot;color:#16A34A;&quot;&gt;[PK]&lt;/span&gt; &lt;u&gt;id_coach&lt;/u&gt;&lt;/td&gt;&#10;    &lt;td style=&quot;padding:4px 8px; text-align:right; font-weight:bold; color:#15803D;&quot;&gt;INT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:4px 8px; color:#1E293B;&quot;&gt;nom&lt;/td&gt;&#10;    &lt;td style=&quot;padding:4px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:4px 8px; color:#1E293B;&quot;&gt;prenom&lt;/td&gt;&#10;    &lt;td style=&quot;padding:4px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr&gt;&#10;    &lt;td style=&quot;padding:4px 8px; color:#1E293B;&quot;&gt;specialite&lt;/td&gt;&#10;    &lt;td style=&quot;padding:4px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5],[0.5,0],[0.5,1]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="table-coach">
          <mxGeometry y="30" width="290" height="120" as="geometry" />
        </mxCell>

        <!-- TABLE 2 : COURS -->
        <mxCell id="table-cours" value="&lt;b&gt;TABLE : COURS&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=4;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#312E81;" vertex="1" parent="1">
          <mxGeometry x="860" y="150" width="290" height="200" as="geometry" />
        </mxCell>
        <mxCell id="table-cours-fields" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica; font-size:11px;&quot;&gt;&#10;  &lt;tr style=&quot;background-color:#F5F3FF; border-bottom:1px solid #DDD6FE;&quot;&gt;&#10;    &lt;td style=&quot;padding:4px 8px; font-weight:bold; color:#4338CA;&quot;&gt;&lt;span style=&quot;color:#4F46E5;&quot;&gt;[PK]&lt;/span&gt; &lt;u&gt;id_cours&lt;/u&gt;&lt;/td&gt;&#10;    &lt;td style=&quot;padding:4px 8px; text-align:right; font-weight:bold; color:#4338CA;&quot;&gt;INT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:4px 8px; color:#1E293B;&quot;&gt;nom&lt;/td&gt;&#10;    &lt;td style=&quot;padding:4px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:4px 8px; color:#1E293B;&quot;&gt;date&lt;/td&gt;&#10;    &lt;td style=&quot;padding:4px 8px; text-align:right; color:#EA580C; font-weight:bold;&quot;&gt;DATE&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:4px 8px; color:#1E293B;&quot;&gt;heure&lt;/td&gt;&#10;    &lt;td style=&quot;padding:4px 8px; text-align:right; color:#D97706; font-weight:bold;&quot;&gt;TIME&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:4px 8px; color:#1E293B;&quot;&gt;capacite_max&lt;/td&gt;&#10;    &lt;td style=&quot;padding:4px 8px; text-align:right; color:#64748B;&quot;&gt;INT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;background-color:#FEF3C7; border-top:1px solid #FDE68A;&quot;&gt;&#10;    &lt;td style=&quot;padding:4px 8px; font-weight:bold; color:#92400E;&quot;&gt;&lt;span style=&quot;color:#D97706;&quot;&gt;[FK]&lt;/span&gt; id_coach&lt;/td&gt;&#10;    &lt;td style=&quot;padding:4px 8px; text-align:right; font-weight:bold; color:#B45309;&quot;&gt;INT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5],[0.5,0],[0.5,1]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="table-cours">
          <mxGeometry y="30" width="290" height="170" as="geometry" />
        </mxCell>

        <!-- TABLE 3 : ADHERENT -->
        <mxCell id="table-adherent" value="&lt;b&gt;TABLE : ADHERENT&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;arcSize=4;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="510" y="440" width="290" height="180" as="geometry" />
        </mxCell>
        <mxCell id="table-adherent-fields" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica; font-size:11px;&quot;&gt;&#10;  &lt;tr style=&quot;background-color:#DBEAFE; border-bottom:1px solid #BFDBFE;&quot;&gt;&#10;    &lt;td style=&quot;padding:4px 8px; font-weight:bold; color:#1E40AF;&quot;&gt;&lt;span style=&quot;color:#2563EB;&quot;&gt;[PK]&lt;/span&gt; &lt;u&gt;id_adherent&lt;/u&gt;&lt;/td&gt;&#10;    &lt;td style=&quot;padding:4px 8px; text-align:right; font-weight:bold; color:#1D4ED8;&quot;&gt;INT&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:4px 8px; color:#1E293B;&quot;&gt;nom&lt;/td&gt;&#10;    &lt;td style=&quot;padding:4px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:4px 8px; color:#1E293B;&quot;&gt;prenom&lt;/td&gt;&#10;    &lt;td style=&quot;padding:4px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr style=&quot;border-bottom:1px solid #F1F5F9;&quot;&gt;&#10;    &lt;td style=&quot;padding:4px 8px; color:#1E293B;&quot;&gt;email&lt;/td&gt;&#10;    &lt;td style=&quot;padding:4px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;  &lt;tr&gt;&#10;    &lt;td style=&quot;padding:4px 8px; color:#1E293B;&quot;&gt;telephone&lt;/td&gt;&#10;    &lt;td style=&quot;padding:4px 8px; text-align:right; color:#64748B;&quot;&gt;VARCHAR(100)&lt;/td&gt;&#10;  &lt;/tr&gt;&#10;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5],[0.5,0],[0.5,1]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="table-adherent">
          <mxGeometry y="30" width="290" height="150" as="geometry" />
